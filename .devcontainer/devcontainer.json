// Compose-based dev container: Docker Desktop must be running.
// Reopen in Container from a local clone of bible-support (File → Open Folder).
//
// Primary repo is mounted at /workspace. Sibling workout-tracker is at
// /workspace/workout-tracker (see docker-compose.yml). Clone it next to bible-support
// or remove that volume from docker-compose.yml.
{
  "name": "full-stack-project",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "extensions": ["learningfuze.lfz-pack"]
    }
  },
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile; sudo chown -R dev:dev ~/.ssh && chmod 700 ~/.ssh && chmod 600 ~/.ssh/* && chmod 644 ~/.ssh/*.pub",
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  }
}

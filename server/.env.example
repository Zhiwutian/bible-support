# Backend-only runtime configuration.
PORT=8080
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_WRITE_MAX=60
DATABASE_URL=postgres://dev:dev@localhost/changeMe
# Optional: cap pg pool size (default 10). Lower on small Postgres plans if you see connection errors.
# PG_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
TOKEN_SECRET=changeMe
AUTH_ENABLED=false
AUTH_PROVIDER=auth0
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SOCIAL_FACEBOOK_ENABLED=false
# With default Vite dev (SPA on :5173, /api proxied), OAuth state cookie is on :5173 — use Vite for callback too:
# AUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
# If client uses VITE_API_BASE_URL=http://localhost:8080 (all API on API host), use:
# AUTH_REDIRECT_URI=http://localhost:8080/api/auth/callback
AUTH_REDIRECT_URI=
AUTH_LOGIN_REDIRECT_URI=
AUTH_LOGOUT_REDIRECT_URI=
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
# OIDC login-state cookie TTL in seconds (default 600 = 10 minutes).
AUTH_LOGIN_STATE_TTL_SECONDS=600
# Use `none` for split-host production (frontend and API on different origins).
SESSION_COOKIE_SAME_SITE=lax
